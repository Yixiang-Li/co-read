/thinking-fast-slow/site/node_modules/
/thinking-fast-slow/site/dist/
/thinking-fast-slow/site/src/fonts/
/thinking-fast-slow/site/.shots/
/thinking-fast-slow/site/preview/
/thinking-fast-slow/site/_v*/
/thinking-fast-slow/site/BRIEF_*.md
/thinking-fast-slow/site/ART_DIRECTION.md
/thinking-fast-slow/site/tools/deploy.sh

.DS_Store
*.log
*.local
